    {
      "name": "Issue player token (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/players/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "players",
            "auth"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalPlayerId\": \"u_42\",\n  \"displayName\": \"Rashad\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "What the game's own server does after logging its player in. The game in the token is the key's game."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "// Decode the JWT the way social does: header and payload are base64url JSON.",
              "const b64 = s => JSON.parse(atob(s.replace(/-/g, '+').replace(/_/g, '/')));",
              "const r = pm.response.json();",
              "pm.test('returns a token and expiresIn 3600', () => {",
              "  pm.expect(r.token.split('.')).to.have.lengthOf(3);",
              "  pm.expect(r.expiresIn).to.eql(3600);",
              "});",
              "pm.test('response is not cacheable', () => pm.response.to.have.header('Cache-Control', 'no-store'));",
              "const [h, p] = r.token.split('.').map(b64);",
              "pm.test('signed with EdDSA', () => pm.expect(h.alg).to.eql('EdDSA'));",
              "pm.test('claims: player, game of the key, name, 1 hour', () => {",
              "  pm.expect(p.typ).to.eql('player');",
              "  pm.expect(p.sub).to.eql('u_42');",
              "  pm.expect(p.name).to.eql('Rashad');",
              "  pm.expect(p.gid).to.eql(pm.collectionVariables.get('gameId'));",
              "  pm.expect(p.exp - p.iat).to.eql(3600);",
              "});",
              "pm.collectionVariables.set('playerToken', r.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Player token is refused on developer endpoints (401)",
      "request": {
