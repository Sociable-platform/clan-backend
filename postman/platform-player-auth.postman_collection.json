{
  "info": {
    "name": "Clan platform - player tokens (TEAM-89)",
    "description": "Run the whole collection in order (Runner). Needs the platform service on {{baseUrl}} with migrations 000001-000003 applied. Creates its own developer, game and key, so it can be re-run. The first four requests are the minimum setup (a key needs a developer and a game); the other collections are not required. Cross-game isolation, token expiry and the public-key-only check are covered by the Go tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "devPassword",
      "value": "correct horse"
    },
    {
      "key": "devEmail",
      "value": ""
    },
    {
      "key": "devToken",
      "value": ""
    },
    {
      "key": "gameId",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "keyId",
      "value": ""
    },
    {
      "key": "playerToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup - register developer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/developers/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "developers",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{devEmail}}\",\n  \"password\": \"{{devPassword}}\",\n  \"name\": \"Dev\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('devEmail', `dev+${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
