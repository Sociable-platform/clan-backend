    {
      "name": "Me - tampered token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/developers/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "developers",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tamperedToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Changes one character in the middle of the signature, so the signature no longer matches."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = pm.collectionVariables.get('token');",
              "const i = t.length - 10; // middle of the signature (the last character only holds padding bits)",
              "const c = t[i] === 'A' ? 'B' : 'A';",
              "pm.collectionVariables.set('tamperedToken', t.slice(0, i) + c + t.slice(i + 1));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));",
              "pm.test('error code is unauthorized', () => pm.expect(pm.response.json().error.code).to.eql('unauthorized'));"
            ]
          }
        }
      ]
    }
