    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/developers/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "developers",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{devEmail}}\",\n  \"password\": \"{{devPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Saves the returned token in the {{token}} collection variable for the requests below."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('returns token and expiresIn', () => {",
              "  pm.expect(b.token).to.be.a('string').and.not.empty;",
              "  pm.expect(b.expiresIn).to.be.a('number').and.above(0);",
              "});",
              "pm.test('token is not cacheable', () => pm.response.to.have.header('Cache-Control', 'no-store'));",
              "pm.collectionVariables.set('token', b.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - with developer token (200)",
      "request": {
        "method": "GET",
        "header": [],
