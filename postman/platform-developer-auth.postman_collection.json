              "pm.test('returns the logged-in developer', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.email).to.eql(pm.collectionVariables.get('devEmail'));",
              "  pm.expect(b).to.not.have.property('passwordHash');",
              "});"
            ]
          }
