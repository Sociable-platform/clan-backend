{
  "info": {
    "name": "Clan platform - developer auth (TEAM-86)",
    "description": "Run the whole collection in order (Runner). Needs the platform service on {{baseUrl}} and migration 000001 applied.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/developers/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "developers",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{devEmail}}\",\n  \"password\": \"{{devPassword}}\",\n  \"name\": \"Postman Dev\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Creates a fresh account. A new unique email is generated for each collection run."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// new unique email per run so the collection can be re-run",
              "pm.collectionVariables.set('devEmail', `postman+${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('returns the developer without secrets', () => {",
              "  pm.expect(b).to.have.keys(['id', 'email', 'name', 'createdAt']);",
              "  pm.expect(b.email).to.eql(pm.collectionVariables.get('devEmail'));",
              "});"
            ]
          }
        }
      ]
    },
