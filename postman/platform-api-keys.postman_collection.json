            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const list = pm.response.json().apiKeys;",
              "pm.test('both keys, newest first', () => {",
              "  pm.expect(list).to.have.lengthOf(2);",
              "  pm.expect(list[0].id).to.eql(pm.collectionVariables.get('secondKeyId'));",
              "});",
              "pm.test('no secret anywhere in the response', () => {",
              "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('apiKey'));",
              "  list.forEach(k => pm.expect(k).to.not.have.property('key'));",
              "});"
            ]
          }
        }
      ]
