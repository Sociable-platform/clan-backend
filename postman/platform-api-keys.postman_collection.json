{
  "info": {
    "name": "Clan platform - game API keys (TEAM-88)",
    "description": "Run the whole collection in order (Runner). Needs the platform service on {{baseUrl}} with migrations 000001-000003 applied. Creates its own developers, so it can be re-run. Whether a revoked key really stops working is covered by the Go tests (the player-token endpoint that uses keys is TEAM-89).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup - register alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/developers/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "developers",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"password\": \"{{devPassword}}\",\n  \"name\": \"Alice\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('aliceEmail', `alice+${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
