    {
      "name": "Create key (201) - full key shown",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/api-keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "api-keys"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{aliceToken}}",
              "type": "string"
            }
          ]
        },
        "description": "The only response that contains the full key. It is saved in {{apiKey}} for the next requests."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const k = pm.response.json();",
              "pm.test('returns the full key once, with prefix and metadata', () => {",
              "  pm.expect(k.key).to.match(/^clk_[A-Za-z0-9_-]{43}$/);",
              "  pm.expect(k.keyPrefix).to.eql(k.key.slice(0, 8));",
              "  pm.expect(k.gameId).to.eql(pm.collectionVariables.get('gameId'));",
              "  pm.expect(k.revokedAt).to.eql(null);",
              "});",
              "pm.test('response is not cacheable', () => pm.response.to.have.header('Cache-Control', 'no-store'));",
              "pm.collectionVariables.set('apiKey', k.key);",
              "pm.collectionVariables.set('keyId', k.id);"
            ]
          }
        }
      ]
    },
