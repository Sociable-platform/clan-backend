              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const games = pm.response.json().games;",
              "pm.test('Alice has exactly her 2 games, newest first', () => {",
              "  pm.expect(games.map(g => g.name)).to.eql(['Alice Second Game', 'Space Raiders']);",
              "});",
              "pm.test(\"Bob's game is not in Alice's list\", () => pm.expect(games.map(g => g.id)).to.not.include(pm.collectionVariables.get('bobGameId')));"
            ]
          }
        }
