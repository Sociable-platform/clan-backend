    {
      "name": "List games - new developer has none (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/games",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{carolToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Carol registers in the pre-request script, so she has no games and the list must be [] (not null)."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = pm.variables.get('baseUrl');",
              "const email = `carol+${Date.now()}@example.com`;",
              "const pw = pm.collectionVariables.get('devPassword');",
              "const post = (path, body) => new Promise((res, rej) => pm.sendRequest({",
              "  url: base + path, method: 'POST', header: { 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify(body) } }, (e, r) => e ? rej(e) : res(r.json())));",
              "post('/api/v1/developers/register', { email, password: pw, name: 'Carol' })",
              "  .then(() => post('/api/v1/developers/login', { email, password: pw }))",
              "  .then(l => pm.collectionVariables.set('carolToken', l.token));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('games is an empty array', () => pm.expect(pm.response.json().games).to.eql([]));"
            ]
          }
        }
      ]
    },
