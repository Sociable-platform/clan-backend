# Copy this file to .env and fill in real values. Never commit .env (it is in .gitignore).
# Use only letters and digits in passwords: they are placed inside database URLs.

LOG_LEVEL=info

# ---- PostgreSQL (docker compose) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=clan
# Host port for Postgres; change it if 5432 is already used on your computer
POSTGRES_HOST_PORT=5432

# Password of each service's own database user (created by deploy/postgres/init)
PLATFORM_DB_PASSWORD=change-me-platform
SOCIAL_DB_PASSWORD=change-me-social
REALTIME_DB_PASSWORD=change-me-realtime

# ---- RabbitMQ (docker compose) ----
# Broker for events between services. Management UI: http://localhost:15672 (log in with the user below).
# Use only letters and digits in the password: it will be placed inside a broker URL.
RABBITMQ_USER=clan
RABBITMQ_PASSWORD=change-me-rabbit
# Host ports; change them if 5672 or 15672 is already used on your computer
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# ---- Browser pages allowed to call each service (CORS) ----
# Comma-separated, exactly scheme://host:port, no trailing slash. "*" is not allowed.
# Dashboard (clan-frontend) runs on 5173, the demo game on 5174.
PLATFORM_CORS_ORIGINS=http://localhost:5173
SOCIAL_CORS_ORIGINS=http://localhost:5174
REALTIME_CORS_ORIGINS=http://localhost:5174

# ---- Platform tokens ----
# Private key that signs developer (and later player) tokens. Only platform gets it.
# Generate it once, see README "JWT signing key". docker compose mounts secrets/platform_jwt_private.pem itself;
# this variable is only needed for `go run`.
PLATFORM_JWT_PRIVATE_KEY_FILE=secrets/platform_jwt_private.pem
# How long a developer token stays valid (Go duration: 30m, 24h). Default 24h.
PLATFORM_DEVELOPER_TOKEN_TTL=24h
# Platform's PUBLIC key. Social uses it to check player tokens; it cannot create tokens with it.
# Create it from the private key, see README "JWT signing key". docker compose mounts it itself;
# this variable is only needed for `go run`.
SOCIAL_JWT_PUBLIC_KEY_FILE=secrets/platform_jwt_public.pem
# Realtime uses the same public key, and only the public one.
REALTIME_JWT_PUBLIC_KEY_FILE=secrets/platform_jwt_public.pem

# ---- Traefik (docker compose) ----
# Host port of the gateway; change it if port 80 is already used on your computer.
TRAEFIK_HOST_PORT=80

# ---- Running a service with `go run` instead of Docker ----
# docker compose sets these itself; you only need them for go run.
# Leave a URL empty to start that service without a database (/ready then reports not ready).
PLATFORM_PORT=8081
PLATFORM_DATABASE_URL=postgres://platform_user:change-me-platform@localhost:5432/clan?sslmode=disable
SOCIAL_PORT=8082
SOCIAL_DATABASE_URL=postgres://social_user:change-me-social@localhost:5432/clan?sslmode=disable
REALTIME_PORT=8083
REALTIME_DATABASE_URL=postgres://realtime_user:change-me-realtime@localhost:5432/clan?sslmode=disable
