# Copy this file to .env and fill in real values. Never commit .env (it is in .gitignore).
# Use only letters and digits in passwords: they are placed inside database URLs.

LOG_LEVEL=info

# ---- PostgreSQL (docker compose) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=clan
# Host port for Postgres; change it if 5432 is already used on your computer
POSTGRES_HOST_PORT=5432

# Password of each service's own database user (created by deploy/postgres/init)
PLATFORM_DB_PASSWORD=change-me-platform
SOCIAL_DB_PASSWORD=change-me-social
REALTIME_DB_PASSWORD=change-me-realtime

# ---- RabbitMQ (docker compose) ----
# Broker for events between services. Management UI: http://localhost:15672 (log in with the user below).
# Use only letters and digits in the password: it will be placed inside a broker URL.
RABBITMQ_USER=clan
RABBITMQ_PASSWORD=change-me-rabbit
# Host ports; change them if 5672 or 15672 is already used on your computer
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# ---- Browser pages allowed to call each service (CORS) ----
# Comma-separated, exactly scheme://host:port, no trailing slash. "*" is not allowed.
# Dashboard (clan-frontend) runs on 5173, the demo game on 5174.
PLATFORM_CORS_ORIGINS=http://localhost:5173
SOCIAL_CORS_ORIGINS=http://localhost:5174
REALTIME_CORS_ORIGINS=http://localhost:5174

# ---- Platform tokens ----
# Private key that signs developer (and later player) tokens. Only platform gets it.
# Generate it once, see README "JWT signing key". docker compose mounts secrets/platform_jwt_private.pem itself;
# this variable is only needed for `go run`.
PLATFORM_JWT_PRIVATE_KEY_FILE=secrets/platform_jwt_private.pem
# How long a developer token stays valid (Go duration: 15m, 1h). Default 15m. It is short on purpose:
# the token cannot be taken back, and the dashboard gets a new one with its refresh cookie.
PLATFORM_DEVELOPER_TOKEN_TTL=15m
# How long an admin token (the admin panel) stays valid. Default 1h; keep it short.
PLATFORM_ADMIN_TOKEN_TTL=1h
# How long a developer stays logged in without using the dashboard: the lifetime of the refresh token in
# the clan_refresh cookie. Every refresh starts it again. Default 168h (7 days).
PLATFORM_DEVELOPER_REFRESH_TTL=168h
# false: the refresh cookie may travel over plain http. Only for http://localhost; docker compose sets
# false by default. Anywhere with https leave it unset (true).
PLATFORM_COOKIE_SECURE=false
# Shared secret of platform's /internal endpoints (GET /internal/v1/games/{gameID}/config), which realtime
# calls with X-Internal-Token. At least 32 characters: openssl rand -hex 32. Empty switches the endpoints off.
PLATFORM_INTERNAL_TOKEN=

# ---- Password reset emails (platform) ----
# Where the dashboard runs: the reset link in the email is <this>/reset-password#token=...
PLATFORM_DASHBOARD_URL=http://localhost:5173
# true: a new developer gets a 6-digit code by email and the account is created only when they enter it
# (README "Email verification at registration"). false, the default: register creates the account at once.
# Without PLATFORM_SMTP_HOST the code is written to platform's log.
PLATFORM_EMAIL_VERIFICATION=false
# The SMTP server that sends the email (STARTTLS, usually port 587). Leave PLATFORM_SMTP_HOST empty on your
# own machine: platform then writes the email, with the link, to its log instead of sending it.
# Gmail: host smtp.gmail.com, username the full address, password an app password (not the account password).
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
# The sender, "noreply@example.com" or "Name <noreply@example.com>". Default: PLATFORM_SMTP_USERNAME.
PLATFORM_SMTP_FROM=
# Platform's PUBLIC key. Social uses it to check player tokens; it cannot create tokens with it.
# Create it from the private key, see README "JWT signing key". docker compose mounts it itself;
# this variable is only needed for `go run`.
SOCIAL_JWT_PUBLIC_KEY_FILE=secrets/platform_jwt_public.pem
# Realtime uses the same public key, and only the public one.
REALTIME_JWT_PUBLIC_KEY_FILE=secrets/platform_jwt_public.pem

# ---- Traefik (docker compose) ----
# Host port of the gateway; change it if port 80 is already used on your computer.
TRAEFIK_HOST_PORT=80

# ---- Running a service with `go run` instead of Docker ----
# docker compose sets these itself; you only need them for go run.
# Leave a URL empty to start that service without a database (/ready then reports not ready).
PLATFORM_PORT=8081
PLATFORM_DATABASE_URL=postgres://platform_user:change-me-platform@localhost:5432/clan?sslmode=disable
# Broker for platform's events (config.published), with RABBITMQ_USER and RABBITMQ_PASSWORD from above.
# Leave it empty to run platform without a broker: Publish then does not reach open widgets until they reconnect.
PLATFORM_RABBITMQ_URL=amqp://clan:change-me-rabbit@localhost:5672/
# Platform's outbox relay (README "Event outbox"): how often it looks for unsent events, and how long sent ones are kept.
PLATFORM_OUTBOX_INTERVAL=1s
PLATFORM_OUTBOX_RETENTION=168h
SOCIAL_PORT=8082
SOCIAL_DATABASE_URL=postgres://social_user:change-me-social@localhost:5432/clan?sslmode=disable
# Broker for social's events, with RABBITMQ_USER and RABBITMQ_PASSWORD from above.
# Leave it empty to run social without a broker: its events are then dropped.
SOCIAL_RABBITMQ_URL=amqp://clan:change-me-rabbit@localhost:5672/
# Social's outbox relay (README "Event outbox"): how often it looks for unsent events, and how long sent ones are kept.
SOCIAL_OUTBOX_INTERVAL=1s
SOCIAL_OUTBOX_RETENTION=168h
# Shared secret of social's /internal endpoints (other services send it as X-Internal-Token), at least 32 characters.
# Make one with: openssl rand -hex 32. Leave it empty to switch those endpoints off (they answer 404).
SOCIAL_INTERNAL_TOKEN=
# Where social reads each game's clan rules (clan.maxMembers from the published config). Leave it empty and every
# game gets the default of 10 members and no game is ever refused as suspended. A new value, a suspension or a
# resume shows up within SOCIAL_CONFIG_CACHE_TTL (30s by default).
SOCIAL_PLATFORM_URL=http://localhost:8081
SOCIAL_CONFIG_CACHE_TTL=30s
REALTIME_PORT=8083
# Where realtime reaches the social service (it asks social for each connecting player's own ID).
REALTIME_SOCIAL_URL=http://localhost:8082
# Startup backfill: when true, realtime reads every friendship from social once, before it starts reading
# events, and stores the conversations it is missing. Needs SOCIAL_INTERNAL_TOKEN set in social, and the same
# value in REALTIME_INTERNAL_TOKEN. Safe to leave on; it only adds.
REALTIME_BACKFILL=false
REALTIME_INTERNAL_TOKEN=
# Where realtime reaches the platform service to read a game's published config (live re-skin).
REALTIME_PLATFORM_URL=http://localhost:8081
REALTIME_DATABASE_URL=postgres://realtime_user:change-me-realtime@localhost:5432/clan?sslmode=disable
# RabbitMQ broker realtime reads events from (queue realtime.events). Empty = do not read events.
# Use the RABBITMQ_USER and RABBITMQ_PASSWORD from above; with docker compose this is built for you.
REALTIME_RABBITMQ_URL=amqp://clan:change-me-rabbit@localhost:5672/
# How long realtime keeps the ID of a handled event, so a copy of the event (delivery is at least once) is skipped.
REALTIME_PROCESSED_EVENTS_RETENTION=168h
# How often realtime counts its dead-letter queue (realtime.events.dead) and logs a warning while it holds rejected events.
REALTIME_DLQ_CHECK_INTERVAL=5m
